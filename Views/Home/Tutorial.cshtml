@{
    ViewData["Title"] = "Tutorial";
}

<h1>¿Cómo jugar?</h1>

<div class="tutorial">

    <h2>1. Elegí tu equipo</h2>

    <p>
        Elegí el equipo con el que querés jugar el Escape Room.
    </p>

    <h2>2. Octavos</h2>

    <p>
        Respondé correctamente las tres preguntas para avanzar.
    </p>

    <h2>3. Cuartos</h2>

    <p>
        Completá el desafío del ahorcado descubriendo el nombre del jugador.
    </p>

    <h2>4. Semifinal</h2>

    <p>
        Usá las pistas para descubrir qué jugador es.
    </p>

    <h2>5. Final</h2>

    <p>
        Resolvé las tres pistas y descubrí el código final.
    </p>

    <h2>🏆 Objetivo</h2>

    <p>
        Superá todas las etapas y completá el Escape Room de Champions League.
    </p>

</div>