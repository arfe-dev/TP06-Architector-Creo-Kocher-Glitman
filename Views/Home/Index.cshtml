    <button type="submit" name="equipo" value="Chelsea"><img src="/Equipos/Chelsea.png.png" alt="Chelsea"></button>
    <button type="submit" name="equipo" value="Manchester United"><img src="/Equipos/United.png" alt="Manchester United"></button>
    <button type="submit" name="equipo" value="Benfica"><img src="/Equipos/Benfica.png.png" alt="Benfica"></button>
    <button type="submit" name="equipo" value="Marsella"><img src="/Equipos/Marsella.png.png" alt="Marsella"></button>

</form>