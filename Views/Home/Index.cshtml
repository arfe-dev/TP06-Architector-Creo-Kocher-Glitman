@{
    ViewData["Title"] = "Elegir equipo";
}


@using TP06.Models

<h1>Elegí tu equipo</h1>

<p>Elegí el equipo con el que vas a jugar la Champions League.</p>

<form  action='@Url.Action("Home", "Index")' method="post">

    <button type="submit" name="equipo" value="Real Madrid">Real Madrid</button>
    <img src="/Equipos/Real.png" alt="Real Madrid">
    <button type="submit" name="equipo" value="Barcelona">Barcelona</button>
    <img src="barcelona-logo.png" alt="Barcelona" />
    <button type="submit" name="equipo" value="Atlético De Madrid">Atlético De Madrid</button>
    <img src="atletico-de-madrid-logo.png" alt="Atlético De Madrid" />
    <button type="submit" name="equipo" value="Liverpool">Liverpool</button>
    <img src="liverpool-logo.png" alt="Liverpool" />
    <button type="submit" name="equipo" value="Bayern Munich">Bayern Munich</button>
    <img src="bayern-munich-logo.png" alt="Bayern Munich" />
    <button type="submit" name="equipo" value="PSG">PSG</button>
    <img src="psg-logo.png" alt="PSG" />
    <button type="submit" name="equipo" value="Arsenal">Arsenal</button>
    <img src="arsenal-logo.png" alt="Arsenal" />
    <button type="submit" name="equipo" value="Inter">Inter</button>
    <img src="inter-logo.png" alt="Inter" />
    <button type="submit" name="equipo" value="Milan">Milan</button>
    <img src="milan-logo.png" alt="Milan" />
    <button type="submit" name="equipo" value="Ajax">Ajax</button>
    <img src="ajax-logo.png" alt="Ajax" />
    <button type="submit" name="equipo" value="Borussia Dortmund">Borussia Dortmund</button>
    <img src="borussia-dortmund-logo.png" alt="Borussia Dortmund" />
    <button type="submit" name="equipo" value="Galatasaray">Galatasaray</button>
    <img src="galatasaray-logo.png" alt="Galatasaray" />
    <button type="submit" name="equipo" value="Chelsea">Chelsea</button>
    <img src="chelsea-logo.png" alt="Chelsea" />
    <button type="submit" name="equipo" value="Manchester United">Manchester United</button>
    <img src="manchester-united-logo.png" alt="Manchester United" />
    <button type="submit" name="equipo" value="Benfica">Benfica</button>
    <img src="benfica-logo.png" alt="Benfica" />
    <button type="submit" name="equipo" value="Marsella">Marsella</button>
    <img src="marsella-logo.png" alt="Marsella" />

</form>