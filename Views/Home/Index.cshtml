@{
    ViewData["Title"] = "Elegir equipo";
}


@using TP06.Models

<h1>Elegí tu equipo</h1>

<p>Elegí el equipo con el que vas a jugar la Champions League.</p>

<form  action='@Url.Action("Index", "Juego")' method="post">

    <button type="submit" name="equipo" value="Real Madrid"><img src="/Equipos/Real.png" alt="Real Madrid"></button>
    <button type="submit" name="equipo" value="Barcelona"><img src="/Equipos/Barca.png" alt="Barcelona"></button>
    <button type="submit" name="equipo" value="Atlético De Madrid"><img src="/Equipos/Atletico.png" alt="Atlético De Madrid"></button>
    <button type="submit" name="equipo" value="Liverpool"><img src="/Equipos/Liverpool.png" alt="Liverpool"></button>

    <button type="submit" name="equipo" value="Bayern Munich"><img src="/Equipos/Bayern.png.png" alt="Bayern Munich"></button>
    <button type="submit" name="equipo" value="PSG"><img src="/Equipos/Psg.png.png" alt="PSG"></button>
    <button type="submit" name="equipo" value="Arsenal"><img src="/Equipos/Arsenal.png.png" alt="Arsenal"></button>
    <button type="submit" name="equipo" value="Inter"><img src="/Equipos/Inter.png.png" alt="Inter"></button>

    <button type="submit" name="equipo" value="Milan"><img src="/Equipos/Milan.png.png" alt="Milan"></button>
