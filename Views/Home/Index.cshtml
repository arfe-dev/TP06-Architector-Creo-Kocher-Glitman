@{
    ViewData["Title"] = "Elegir equipo";
}


@using TP06.Models

<h1>Elegí tu equipo</h1>

@if (ViewBag.Mensaje != null)
{
    <h3>@ViewBag.Mensaje</h3>
}

<p>Elegí el equipo con el que vas a jugar la Champions League.</p>

<form  action='@Url.Action("Index", "Juego")' method="post">

    <button type="submit" name="equipo" value="Real Madrid"><img src="/Equipos/Real Madrid.png" alt="Real Madrid"></button>
    <button type="submit" name="equipo" value="Barcelona"><img src="/Equipos/Barcelona.png" alt="Barcelona"></button>
    <button type="submit" name="equipo" value="Atletico De Madrid"><img src="/Equipos/Atletico De Madrid.png" alt="Atlético De Madrid"></button>
    <button type="submit" name="equipo" value="Liverpool"><img src="/Equipos/Liverpool.png" alt="Liverpool"></button>

    <button type="submit" name="equipo" value="Bayern Munich"><img src="/Equipos/Bayern Munich.png" alt="Bayern Munich"></button>
    <button type="submit" name="equipo" value="PSG"><img src="/Equipos/PSG.png" alt="PSG" class="escudo-psg"></button>
    <button type="submit" name="equipo" value="Arsenal"><img src="/Equipos/Arsenal.png" alt="Arsenal"></button>
    <button type="submit" name="equipo" value="Inter"><img src="/Equipos/Inter.png" alt="Inter"></button>

    <button type="submit" name="equipo" value="Milan"><img src="/Equipos/Milan.png" alt="Milan"></button>
    <button type="submit" name="equipo" value="Ajax"><img src="/Equipos/Ajax.png" alt="Ajax"></button>
    <button type="submit" name="equipo" value="Dortmund"><img src="/Equipos/Dortmund.png" alt="Borussia Dortmund"></button>
    <button type="submit" name="equipo" value="Galatasaray"><img src="/Equipos/Galatasaray.png" alt="Galatasaray"></button>

    <button type="submit" name="equipo" value="Chelsea"><img src="/Equipos/Chelsea.png" alt="Chelsea"></button>
    <button type="submit" name="equipo" value="Manchester United"><img src="/Equipos/Manchester United.png" alt="Manchester United"></button>
    <button type="submit" name="equipo" value="Benfica"><img src="/Equipos/Benfica.png" alt="Benfica"></button>
    <button type="submit" name="equipo" value="Marsella"><img src="/Equipos/Marsella.png" alt="Marsella"></button>

</form>