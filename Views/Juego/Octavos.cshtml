@{
    ViewData["Title"] = "Home Page";
}

@using TP06.Models

<h1>Octavos de Final</h1>

<h2>Equipo elegido: @ViewBag.Equipo</h2>

<img src="/Equipos/@ViewBag.Imagen" alt="@ViewBag.Equipo">


<form action='@Url.Action("Octavos", "Juego")' method="post">

    <div class="pregunta-block">
        <h2 class="pregunta-enunciado">@Model[0].Enunciado</h2>

        @foreach (var opcion in Model[0].Opciones)
        {
            <label class="pregunta-opcion">
                <input type="radio" name="respuesta1" value="@opcion">
                <span>@opcion</span>
            </label>
        }
    </div>

    <div class="pregunta-block">
        <h2 class="pregunta-enunciado">@Model[1].Enunciado</h2>

        @foreach (var opcion in Model[1].Opciones)
        {
            <label class="pregunta-opcion">
                <input type="radio" name="respuesta2" value="@opcion">
                <span>@opcion</span>
            </label>
        }
    </div>

    <div class="pregunta-block">
        <h2 class="pregunta-enunciado">@Model[2].Enunciado</h2>

        @foreach (var opcion in Model[2].Opciones)
        {
            <label class="pregunta-opcion">
                <input type="radio" name="respuesta3" value="@opcion">
                <span>@opcion</span>
            </label>
        }
    </div>

    <br><br>

    <button type="submit">Responder</button>

</form>