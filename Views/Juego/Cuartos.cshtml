@{
    ViewData["Title"] = "Cuartos de Final";
}

<h1>Cuartos de Final</h1>

<h2>Adiviná el jugador</h2>

<div class="ahorcado">
    <h2 id="palabraOculta">@ViewBag.PalabraOculta</h2>

    <h4>Intentos restantes:</h4>

    <h4 id="intentos">@ViewBag.Intentos</h4>

    @if (ViewBag.Mensaje != null)
    {
        <h4 id="mensaje">@ViewBag.Mensaje</h4>
    }

    <form action='@Url.Action("Cuartos", "Juego")' method="post">

        <p>Ingresá una letra:</p>

        <input type="text" name="letra" maxlength="1" required />

        <button type="submit">
            Arriesgar letra
        </button>

    </form>
</div>